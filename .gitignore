# ============================================
# AIFilmer .gitignore
# ============================================

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Editors / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ---------- Xcode ----------
build/
DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.moved-aside
*.xccheckout
*.xcscmblueprint
*.xcscheme
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
.build/
Packages/
Package.pins
Package.resolved

# CocoaPods
Pods/
*.podspec.json

# Carthage
Carthage/Build/
Carthage/Checkouts/

# ---------- Python / Backend ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/
ENV/
.mypy_cache/
.ruff_cache/

# Node (if backend has JS bits)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# ---------- Models / Data (large binary) ----------
models/**/*.mlmodel
models/**/*.mlpackage
models/**/*.tflite
models/**/*.onnx
models/**/*.pt
models/**/*.pth
models/**/*.bin
models/**/*.gguf
models/**/*.safetensors

# Allow README inside models/
!models/README.md

# ---------- Secrets / Config ----------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
config.local.yaml
config.local.yml
config.local.json
secrets.json
google-services.json
GoogleService-Info.plist

# ---------- Test artifacts ----------
*.log
logs/
test-results/
coverage/
*.xcresult

# ---------- Generated docs ----------
docs/_build/
docs/_generated/

# ---------- Build outputs ----------
*.app
*.exe
*.dll
*.so
*.dylib
dist/
build/
out/
target/

# ---------- OS generated ----------
.vs/
bin/
obj/

# ---------- Misc ----------
*.bak
*.tmp
*.orig
*.rej
.cache/